{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"rewriteRelativeImportExtensions": true,
		"sourceMap": true,
		"strict": true,
		// worker-configuration.d.ts imports the built worker; don't type-check generated JS
		"checkJs": false,
		"types": ["$app/types", "unplugin-icons/types/svelte"]
	},
	"include": ["src", "vite.config.ts"]
}
