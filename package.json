		"mdsvex": "^1.0.1",
		"prettier": "3.10.1",
		"storybook": "^10.6.8",
		"svelte": "^5.59.1",
		"svelte-check": "^4.7.8",
		"typescript": "~6.0.3",
		"unplugin-icons": "^24.0.0",
		"vite": "^8.3.8"
