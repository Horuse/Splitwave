		"@xyflow/svelte": "^2.0.2",
		"esm-env": "^1.2.2",
		"pele": "1.13.0",
		"prettier-plugin-svelte": "^4.2.0",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"semver": "^7.8.6",
		"svelte-floating-ui": "^1.6.2",
		"svelte-french-toast": "^1.2.0",
		"svelte-portal": "^2.2.1",
		"tailwindcss": "^4.3.5"
	},
	"devDependencies": {
