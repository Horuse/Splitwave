{
	"name": "splitwave",
	"private": true,
	"type": "module",
	"license": "MIT",
	"workspaces": {
		"packages": [
			"packages/*",
			"apps/*"
		],
		"catalog": {
			"@iconify-json/fluent": "^1.2.62",
			"@number-flow/svelte": "^0.4.2",
			"@storybook/addon-a11y": "^10.6.8",
			"@storybook/addon-docs": "^10.6.8",
			"@storybook/addon-svelte-csf": "^5.1.6",
			"@storybook/svelte-vite": "^10.6.8",
			"@sveltejs/kit": "^3.4.0",
			"@sveltejs/vite-plugin-svelte": "^7.3.1",
			"@tailwindcss/vite": "^4.3.5",
			"@xyflow/svelte": "^2.0.2",
			"bun-types": "^1.4.5",
			"mdsvex": "^1.0.1",
			"prettier": "3.10.1",
			"prettier-plugin-svelte": "^4.2.0",
			"prettier-plugin-tailwindcss": "^0.8.1",
			"storybook": "^10.6.8",
			"svelte": "^5.59.1",
			"svelte-check": "^4.7.8",
			"svelte-floating-ui": "^1.6.2",
			"svelte-portal": "^2.2.1",
			"tailwindcss": "^4.3.5",
			"typescript": "~6.0.3",
			"unplugin-icons": "^24.0.0",
			"vite": "^8.3.8"
		}
	},
	"scripts": {
		"dev": "bun run --cwd apps/desktop dev",
		"build": "bun run --cwd apps/desktop build",
		"tauri": "bun run --cwd apps/desktop tauri",
		"test": "bun scripts/test-all.ts",
		"test:frontend": "bun run --cwd apps/desktop test",
		"check": "bun scripts/check-all.ts",
		"check:frontend": "bun run --cwd apps/desktop check",
		"format": "prettier --write \"**/*.{ts,tsx,md,svelte,json}\" && cargo fmt --manifest-path apps/desktop/src-tauri/Cargo.toml",
		"generate": "bun run --cwd apps/desktop generate",
		"bump": "bun scripts/bump-version.ts",
		"storybook": "bun run --cwd apps/desktop storybook",
		"build-storybook": "bun run --cwd apps/desktop build-storybook"
	},
	"devDependencies": {
		"bun-types": "catalog:",
		"prettier": "catalog:",
		"prettier-plugin-svelte": "catalog:",
		"prettier-plugin-tailwindcss": "catalog:"
	}
}
